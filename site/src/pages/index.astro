---
// Landing page — served at the site root, outside Starlight's docs routing
import '../styles/custom.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const chapters = [
  { num: '00', label: 'Executive Summary',    slug: '00-executive-summary/chapter',    desc: 'The complete business case in a single chapter.' },
  { num: '01', label: 'Introduction',          slug: '01-introduction/chapter',          desc: 'Why automation matters and how this handbook is structured.' },
  { num: '02', label: 'Business Alignment',    slug: '02-business-alignment/chapter',    desc: 'Connecting automation investment to business outcomes.' },
  { num: '03', label: 'Maturity Model',        slug: '03-maturity-model/chapter',        desc: 'Five levels from reactive operations to adaptive infrastructure.' },
  { num: '04', label: 'Transformation Roadmap', slug: '04-transformation-roadmap/chapter', desc: 'A phased plan with measurable milestones at each stage.' },
  { num: '05', label: 'Tooling Strategy',      slug: '05-tooling-strategy/chapter',      desc: 'Buy vs build decisions and platform selection principles.' },
  { num: '06', label: 'Architecture Patterns', slug: '06-architecture-patterns/chapter', desc: 'Source of truth, intent model, and pipeline architecture.' },
  { num: '07', label: 'Implementation Guides', slug: '07-implementation-guides/chapter', desc: 'Config as code, CI/CD pipelines, testing, and deployment.' },
  { num: '08', label: 'Operations Automation', slug: '08-operations-automation/chapter', desc: 'Monitoring, event-driven automation, and auto-remediation.' },
  { num: '09', label: 'Greenfield Design',     slug: '09-greenfield-design/chapter',     desc: 'Building automation-native infrastructure from day one.' },
  { num: '10', label: 'People & Skills',       slug: '10-people-and-skills/chapter',     desc: 'The human transformation — roles, skills, and org models.' },
  { num: '11', label: 'Advanced Topics',       slug: '11-advanced-topics/chapter',       desc: 'Intent-based networking, AI operations, and self-healing.' },
  { num: '12', label: 'Security & Compliance', slug: '12-security-compliance/chapter',   desc: 'Policy as code, traceability, and continuous compliance.' },
  { num: '13', label: 'Dashboards & Metrics',  slug: '13-dashboards/chapter',            desc: 'Executive, engineering, and operations dashboard views.' },
];

const pillars = [
  {
    icon: 'shield',
    label: 'Risk Reduction',
    stat: '60–80%',
    detail: 'fewer change-related incidents',
    color: 'from-sky-900/40 to-sky-950/20 border-sky-800/50',
    iconColor: 'text-sky-400',
  },
  {
    icon: 'chart',
    label: 'Cost Reduction',
    stat: '40–60%',
    detail: 'less manual operational effort',
    color: 'from-emerald-900/40 to-emerald-950/20 border-emerald-800/50',
    iconColor: 'text-emerald-400',
  },
  {
    icon: 'bolt',
    label: 'Business Agility',
    stat: 'Days → Hours',
    detail: 'change lead time reduction',
    color: 'from-amber-900/40 to-amber-950/20 border-amber-800/50',
    iconColor: 'text-amber-400',
  },
  {
    icon: 'pulse',
    label: 'Service Quality',
    stat: '50–70%',
    detail: 'reduction in MTTR',
    color: 'from-violet-900/40 to-violet-950/20 border-violet-800/50',
    iconColor: 'text-violet-400',
  },
];
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="A strategic guide for financial services organisations transforming network operations through automation." />
    <title>Network Automation Handbook</title>
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <script data-goatcounter="https://networkautomationhandbook.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { font-family: 'Inter', system-ui, sans-serif; background: #050d1a; color: #f8fafc; scroll-behavior: smooth; }
      body { min-height: 100vh; }
    </style>
  </head>

  <body class="bg-[#050d1a] text-slate-50">

    <!-- ── Navigation ──────────────────────────────────────────────────────── -->
    <nav class="fixed top-0 inset-x-0 z-50 border-b border-[#1e3a5f]/60 bg-[#050d1a]/80 backdrop-blur-md">
      <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="28" height="28" rx="6" fill="#0ea5e9" fill-opacity="0.15"/>
            <path d="M6 14h4l3-6 4 12 3-8 2 2h4" stroke="#0ea5e9" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span class="font-semibold text-slate-100 tracking-tight">Network Automation Handbook</span>
        </div>
        <div class="flex items-center gap-4">
          <a href="https://github.com/ppklau/network_automation_handbook"
             target="_blank" rel="noopener"
             class="hidden sm:flex items-center gap-1.5 text-sm text-slate-400 hover:text-slate-200 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            GitHub
          </a>
          <a href={`${base}/00-executive-summary/chapter`}
             class="px-4 py-2 rounded-lg bg-sky-600 hover:bg-sky-500 text-white text-sm font-medium transition-colors">
            Read Handbook
          </a>
        </div>
      </div>
    </nav>

    <!-- ── Hero ────────────────────────────────────────────────────────────── -->
    <section class="relative pt-32 pb-24 px-6 overflow-hidden">
      <!-- Background glow -->
      <div class="absolute inset-0 pointer-events-none">
        <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[400px] bg-sky-600/10 rounded-full blur-3xl"></div>
        <div class="absolute top-1/4 left-1/4 w-[300px] h-[300px] bg-violet-600/6 rounded-full blur-3xl"></div>
      </div>

      <div class="relative max-w-4xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-sky-800/60 bg-sky-900/20 text-sky-300 text-xs font-medium mb-8 tracking-wide uppercase">
          <span class="w-1.5 h-1.5 rounded-full bg-sky-400 animate-pulse"></span>
          For architects, engineers &amp; senior leaders
        </div>

        <h1 class="text-5xl sm:text-6xl lg:text-7xl font-bold tracking-tight leading-[1.05] mb-6">
          <span class="text-slate-50 text-4xl sm:text-5xl lg:text-6xl block mb-2 opacity-90">Stop Configuring Devices.</span>
          <span class="bg-gradient-to-r from-sky-400 via-sky-300 to-cyan-300 bg-clip-text text-transparent">Start Delivering Capability.</span>
        </h1>

        <p class="text-xl text-slate-400 max-w-3xl mx-auto mb-10 leading-relaxed">
          The definitive framework for transforming manual network operations into a high-velocity, intent-based platform. 
          Built for <span class="text-slate-200">senior leaders, architects, and engineers</span> who value risk reduction and business agility over scripts.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href={`${base}/00-executive-summary/chapter`}
             class="w-full sm:w-auto px-8 py-4 rounded-xl bg-sky-600 hover:bg-sky-500 text-white font-semibold text-lg transition-all hover:shadow-lg hover:shadow-sky-600/25 flex items-center justify-center gap-2">
            Read the Executive Summary
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
          <a href={`${base}/03-maturity-model/chapter`}
             class="w-full sm:w-auto px-8 py-4 rounded-xl border border-[#1e3a5f] hover:border-sky-700/60 text-slate-300 hover:text-slate-100 font-medium text-lg transition-all flex items-center justify-center gap-2">
            Assess your maturity
          </a>
        </div>
      </div>
    </section>

    <!-- ── Persona Paths ─────────────────────────────────────────────────── -->
    <section class="px-6 pb-20 -mt-8 relative z-10">
      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-[#0a1628]/80 backdrop-blur border border-sky-900/40 p-8 rounded-2xl hover:border-sky-500/40 transition-all group">
            <div class="w-12 h-12 bg-sky-900/30 rounded-xl flex items-center justify-center mb-6 border border-sky-800/50 group-hover:scale-110 transition-transform">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            </div>
            <h3 class="text-xl font-bold text-slate-100 mb-3">For Network Leaders</h3>
            <p class="text-slate-400 text-sm leading-relaxed mb-6">Learn to build the business case, map technical debt to financial risk, and lead organizational change that sticks.</p>
            <ul class="space-y-3 mb-8">
              <li class="flex items-center gap-2 text-xs text-slate-300"><svg class="text-sky-500" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg> Investment Frameworks</li>
              <li class="flex items-center gap-2 text-xs text-slate-300"><svg class="text-sky-500" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg> Strategic Dashboards</li>
            </ul>
            <a href={`${base}/02-business-alignment/chapter`} class="text-sky-400 text-sm font-semibold hover:text-sky-300 flex items-center gap-2">Explore the Business Case &rarr;</a>
          </div>

          <div class="bg-[#0a1628]/80 backdrop-blur border border-emerald-900/40 p-8 rounded-2xl hover:border-emerald-500/40 transition-all group">
            <div class="w-12 h-12 bg-emerald-900/30 rounded-xl flex items-center justify-center mb-6 border border-emerald-800/50 group-hover:scale-110 transition-transform">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
            </div>
            <h3 class="text-xl font-bold text-slate-100 mb-3">For Architects</h3>
            <p class="text-slate-400 text-sm leading-relaxed mb-6">Design intent models, source-of-truth schemas, and CI/CD pipelines that transform infrastructure into a platform.</p>
            <ul class="space-y-3 mb-8">
              <li class="flex items-center gap-2 text-xs text-slate-300"><svg class="text-emerald-500" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg> Multi-vendor Patterns</li>
              <li class="flex items-center gap-2 text-xs text-slate-300"><svg class="text-emerald-500" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg> Intent Verification</li>
            </ul>
            <a href={`${base}/06-architecture-patterns/chapter`} class="text-emerald-400 text-sm font-semibold hover:text-emerald-300 flex items-center gap-2">See Reference Patterns &rarr;</a>
          </div>

          <div class="bg-[#0a1628]/80 backdrop-blur border border-violet-900/40 p-8 rounded-2xl hover:border-violet-500/40 transition-all group">
            <div class="w-12 h-12 bg-violet-900/30 rounded-xl flex items-center justify-center mb-6 border border-violet-800/50 group-hover:scale-110 transition-transform">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"></path><path d="M2 17l10 5 10-5"></path><path d="M2 12l10 5 10-5"></path></svg>
            </div>
            <h3 class="text-xl font-bold text-slate-100 mb-3">Professional Mastery</h3>
            <p class="text-slate-400 text-sm leading-relaxed mb-6">Transition from scripting to NetDevOps architecture. Turn transformation expertise into a high-value career or business.</p>
            <ul class="space-y-3 mb-8">
              <li class="flex items-center gap-2 text-xs text-slate-300"><svg class="text-violet-500" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg> Product Mindset</li>
              <li class="flex items-center gap-2 text-xs text-slate-300"><svg class="text-violet-500" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg> Career Transformation</li>
            </ul>
            <a href={`${base}/10-people-and-skills/chapter`} class="text-violet-400 text-sm font-semibold hover:text-violet-300 flex items-center gap-2">Evolve Your Career &rarr;</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Value Pillars ────────────────────────────────────────────────────── -->
    <section class="px-6 pb-20">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-2xl font-semibold text-slate-100 mb-2">What automation delivers</h2>
          <p class="text-slate-400 text-sm">Reported outcomes from organisations that have completed the transformation</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {pillars.map(p => (
            <div class={`relative rounded-2xl border bg-gradient-to-b p-6 ${p.color}`}>
              <div class={`text-3xl font-bold mb-1 ${p.iconColor}`}>{p.stat}</div>
              <div class="text-slate-300 font-medium mb-1">{p.label}</div>
              <div class="text-slate-500 text-sm">{p.detail}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Maturity Journey ─────────────────────────────────────────────────── -->
    <section class="px-6 pb-20">
      <div class="max-w-6xl mx-auto">
        <div class="rounded-3xl border border-[#1e3a5f] bg-[#0a1628] p-10 relative overflow-hidden">
          <div class="absolute top-0 right-0 w-64 h-64 bg-sky-500/5 rounded-full blur-3xl -mr-32 -mt-32"></div>
          
          <div class="relative z-10">
            <h2 class="text-3xl font-bold text-slate-100 mb-3 text-center">The NetDevOps Maturity Model</h2>
            <p class="text-slate-400 text-center max-w-2xl mx-auto mb-12">
              Transformation is a journey, not a switch. Identify where your organization stands today to plan a realistic path forward.
            </p>
            
            <div class="grid grid-cols-1 sm:grid-cols-5 gap-4">
              {[
                { level: 'L1', name: 'Reactive',     desc: 'Everything starts with a ticket. Manual CLI access.', color: 'bg-red-500/20 text-red-400 border-red-500/30' },
                { level: 'L2', name: 'Task-Based',   desc: 'Scripts on laptops. Inconsistent, personal automation.',    color: 'bg-orange-500/20 text-orange-400 border-orange-500/30' },
                { level: 'L3', name: 'Integrated',   desc: 'Source of Truth & Git. Team-wide discipline.', color: 'bg-amber-500/20 text-amber-400 border-amber-500/30' },
                { level: 'L4', name: 'Platform',     desc: 'CI/CD pipelines. Behavioural testing before deployment.',      color: 'bg-emerald-500/20 text-emerald-400 border-emerald-500/30' },
                { level: 'L5', name: 'Adaptive',     desc: 'Intent-driven. Self-healing and continuous compliance.',        color: 'bg-sky-500/20 text-sky-400 border-sky-500/30' },
              ].map((l, i) => (
                <div class="bg-[#050d1a] p-6 rounded-2xl border border-[#1e3a5f] hover:border-sky-500/30 transition-all flex flex-col items-center text-center">
                  <div class={`px-3 py-1 rounded-full text-xs font-bold mb-4 border ${l.color}`}>{l.level}</div>
                  <div class="text-slate-100 font-bold mb-2">{l.name}</div>
                  <div class="text-slate-500 text-xs leading-relaxed">{l.desc}</div>
                </div>
              ))}
            </div>
            
            <div class="mt-10 pt-10 border-t border-[#1e3a5f]/50 flex flex-col sm:flex-row items-center justify-between gap-6">
              <div class="text-sm text-slate-400 italic">"Most enterprise networks are currently transitioning from L1 to L2."</div>
              <a href={`${base}/03-maturity-model/chapter`}
                 class="px-6 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-sm font-semibold flex items-center gap-2 transition-all">
                Run an Assessment Workshop
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Toolkit Showcase ────────────────────────────────────────────────── -->
    <section class="px-6 pb-24">
      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="text-3xl font-bold text-slate-100 mb-6">A Complete Transformation Toolkit</h2>
            <p class="text-slate-400 mb-8 leading-relaxed text-lg">
              This isn't just a book. It's a system for delivery. We provide the machine-readable templates, 
              scripts, and architectures you need to start moving today.
            </p>
            <div class="space-y-6">
              <div class="flex gap-4">
                <div class="shrink-0 w-10 h-10 rounded-lg bg-sky-500/10 border border-sky-500/30 flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                </div>
                <div>
                  <h4 class="text-slate-100 font-semibold mb-1">20+ Executive & Technical Templates</h4>
                  <p class="text-slate-500 text-sm">Business cases, ADRs, TCO models, and maturity assessment questionnaires ready to download.</p>
                </div>
              </div>
              <div class="flex gap-4">
                <div class="shrink-0 w-10 h-10 rounded-lg bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
                </div>
                <div>
                  <h4 class="text-slate-100 font-semibold mb-1">Functional Code Examples</h4>
                  <p class="text-slate-500 text-sm">Working GitLab CI pipelines, Batfish validation scripts, and one-touch branch generators.</p>
                </div>
              </div>
              <div class="flex gap-4">
                <div class="shrink-0 w-10 h-10 rounded-lg bg-violet-500/10 border border-violet-500/30 flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg>
                </div>
                <div>
                  <h4 class="text-slate-100 font-semibold mb-1">Reference Architecture</h4>
                  <p class="text-slate-500 text-sm">Multi-vendor Source of Truth schemas and Jinja2 templates for enterprise data centers.</p>
                </div>
              </div>
            </div>
            <div class="mt-10">
              <a href={`${base}/templates`} class="inline-flex items-center gap-2 text-sky-400 font-bold hover:text-sky-300 transition-colors">
                View the Template Directory
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          </div>
          
          <div class="relative">
            <div class="absolute inset-0 bg-gradient-to-tr from-sky-500/20 to-violet-500/20 rounded-3xl blur-2xl opacity-50"></div>
            <div class="relative bg-[#0a1628] border border-[#1e3a5f] p-4 rounded-3xl shadow-2xl">
              <div class="bg-[#050d1a] rounded-2xl p-6 font-mono text-xs leading-relaxed text-slate-400 overflow-hidden h-80">
                <div class="text-emerald-400 mb-2"># ACME Investments Intent Model</div>
                <div class="text-sky-400 mb-4">design_intents.yml</div>
                <div>intent: INTENT-SEG-01</div>
                <div>  description: "Security zone isolation"</div>
                <div>  test: "assert no route leaking"</div>
                <div class="mt-6 text-sky-400 mb-4">nodes.yml</div>
                <div>- hostname: leaf01</div>
                <div>  intent: [INTENT-SEG-01]</div>
                <div>  vrfs: [TRADING, CORPORATE]</div>
