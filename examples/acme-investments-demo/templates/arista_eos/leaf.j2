{# Arista EOS — Leaf / Border-Leaf Template
   Input: nodes.yml entry with role: leaf or border_leaf
   Generated by: playbooks/generate_configs.yml
   Do not edit this file directly on devices.
#}
! ============================================================
! {{ hostname }} — Arista EOS {{ role | replace('_', ' ') | title }}
! Site: {{ site }}
! Generated by network automation pipeline
! Source of truth: inventory/nodes.yml
! Intents: {{ intent | join(', ') }}
! ============================================================

hostname {{ hostname }}

! ── Management ──────────────────────────────────────────────
vrf instance {{ management.vrf }}

interface Management0
   vrf {{ management.vrf }}
   ip address {{ management.address }}

ip route vrf {{ management.vrf }} 0.0.0.0/0 {{ management.address | ipaddr('network') | ipmath(1) }}

management ssh
   vrf {{ management.vrf }}

management api http-commands
   protocol https
   no protocol http
   vrf {{ management.vrf }}
      no shutdown

! ── Syslog ─────────────────────────────────────────────────
{% for server in management.syslog_servers %}
logging host {{ server }} vrf {{ management.vrf }}
{% endfor %}
logging trap informational

! ── SNMP ───────────────────────────────────────────────────
snmp-server vrf {{ management.vrf }}
snmp-server group SNMPV3_GROUP v3 priv
snmp-server user SNMPV3_USER SNMPV3_GROUP v3 auth sha {{ snmp_auth_key | default('CHANGEME_AUTH') }} priv aes {{ snmp_priv_key | default('CHANGEME_PRIV') }}

! ── VRF Definitions ─────────────────────────────────────────
{% for vrf in vxlan.vrfs %}
vrf instance {{ vrf.name }}
{% endfor %}

! ── Loopbacks ───────────────────────────────────────────────
interface Loopback0
   description "Router-ID / BGP Source"
   ip address {{ loopback.address }}

interface Loopback1
   description "VXLAN VTEP Source"
   ip address {{ vxlan.loopback1_address }}

! ── MLAG ────────────────────────────────────────────────────
{% if mlag is defined %}
mlag configuration
   domain-id {{ mlag.domain_id }}
   local-interface Vlan4094
   peer-address {{ mlag.peer_address }}
   peer-link Port-Channel1
   reload-delay mlag 300
   reload-delay non-mlag 330

vlan 4094
   name MLAG_PEER
   trunk group MLAG_PEER

interface Port-Channel1
   description "MLAG Peer Link to {{ mlag.peer }}"
   switchport mode trunk
   switchport trunk group MLAG_PEER
   mtu 9214

interface Vlan4094
   description "MLAG Peer Link L3"
   mtu 9214
   ip address 169.254.0.{{ '1' if mlag.peer_address > loopback.address else '2' }}/30
{% endif %}

! ── VXLAN ───────────────────────────────────────────────────
interface Vxlan1
   vxlan source-interface {{ vxlan.source_interface }}
   vxlan udp-port 4789
{% for vlan_entry in vxlan.vlans %}
   vxlan vlan {{ vlan_entry.vlan }} vni {{ vlan_entry.vni }}
{% endfor %}
{% for vrf_entry in vxlan.vrfs %}
   vxlan vrf {{ vrf_entry.name }} vni {{ vrf_entry.l3vni }}
{% endfor %}

! ── VLANs ───────────────────────────────────────────────────
{% for vlan_entry in vxlan.vlans %}
vlan {{ vlan_entry.vlan }}
   name {{ vlan_entry.name }}
{% endfor %}

! ── ACLs (applied on SVIs — intent: INTENT-SEG-02) ──────────
{% for acl in acls %}
ip access-list {{ acl.name }}
{% for entry in acl.entries %}
   {{ entry.seq }} {{ entry.action }} {{ entry.protocol }}
   {%- if entry.src is defined %} {{ entry.src }}{% endif %}
   {%- if entry.dst is defined %} {{ entry.dst }}{% endif %}
   {%- if entry.dst_port is defined and entry.dst_port != 'any' %}
   {%- if entry.dst_port is iterable and entry.dst_port is not string %}
   {%- for port in entry.dst_port %} eq {{ port }}{% endfor %}
   {%- else %} eq {{ entry.dst_port }}{% endif %}
   {%- endif %}
   {%- if entry.dst_port == 'established' %} established{% endif %}
   {# Requirement traceability comment rendered into device config #}
   remark {{ entry.comment }}
{% endfor %}
{% endfor %}

! ── SVIs ─────────────────────────────────────────────────────
{% for svi in svis %}
interface Vlan{{ svi.vlan }}
   description "{{ svi.name }}"
   vrf {{ svi.vrf }}
   ip address {{ svi.ip }}
{% if svi.acl_in is defined %}
   ip access-group {{ svi.acl_in }} in
{% endif %}
   no shutdown
{% endfor %}

! ── BGP Underlay ─────────────────────────────────────────────
router bgp {{ bgp.asn }}
   router-id {{ bgp.router_id }}
   no bgp default ipv4-unicast
   maximum-paths 4 ecmp 4
   !
   neighbor UNDERLAY-SPINES peer group
   neighbor UNDERLAY-SPINES send-community
   neighbor UNDERLAY-SPINES maximum-routes 12000
   !
{% for peer in bgp.underlay_peers %}
   neighbor {{ peer.peer_ip }} peer group UNDERLAY-SPINES
   neighbor {{ peer.peer_ip }} remote-as {{ peer.peer_asn }}
   neighbor {{ peer.peer_ip }} description "{{ peer.description }}"
{% endfor %}
   !
   address-family ipv4
      neighbor UNDERLAY-SPINES activate
      network {{ loopback.address }}
      network {{ vxlan.loopback1_address }}

! ── BGP EVPN Overlay ─────────────────────────────────────────
{% if bgp.evpn.enabled %}
   neighbor OVERLAY-EVPN peer group
   neighbor OVERLAY-EVPN update-source Loopback0
   neighbor OVERLAY-EVPN ebgp-multihop 3
   neighbor OVERLAY-EVPN send-community extended
   neighbor OVERLAY-EVPN maximum-routes 0
   !
{% for peer in bgp.evpn.overlay_peers %}
   neighbor {{ peer.peer_ip }} peer group OVERLAY-EVPN
   neighbor {{ peer.peer_ip }} remote-as {{ peer.peer_asn }}
   neighbor {{ peer.peer_ip }} description "{{ peer.description }}"
{% endfor %}
   !
   address-family evpn
      neighbor OVERLAY-EVPN activate
   !
{% for vrf_entry in vxlan.vrfs %}
   vrf {{ vrf_entry.name }}
      rd {{ bgp.router_id }}:{{ vrf_entry.l3vni }}
      route-target import evpn {{ vrf_entry.l3vni }}:{{ vrf_entry.l3vni }}
      route-target export evpn {{ vrf_entry.l3vni }}:{{ vrf_entry.l3vni }}
      redistribute connected
{% endfor %}
{% endif %}

! ── NTP ─────────────────────────────────────────────────────
ntp server 10.0.0.100 vrf {{ management.vrf }}
ntp server 10.0.0.101 vrf {{ management.vrf }}

! ── AAA ─────────────────────────────────────────────────────
aaa authentication login default local
aaa authorization exec default local

! End of {{ hostname }} configuration
