{# Arista EOS — Spine Template
   Input: nodes.yml entry with role: spine
   Generated by: playbooks/generate_configs.yml
   Do not edit this file directly on devices.
#}
! ============================================================
! {{ hostname }} — Arista EOS Spine
! Site: {{ site }}
! Generated by network automation pipeline
! Source of truth: inventory/nodes.yml
! Intents: {{ intent | join(', ') }}
! ============================================================

hostname {{ hostname }}

! ── Management ──────────────────────────────────────────────
vrf instance {{ management.vrf }}

interface Management0
   vrf {{ management.vrf }}
   ip address {{ management.address }}

ip route vrf {{ management.vrf }} 0.0.0.0/0 {{ management.address | ipaddr('network') | ipmath(1) }}

management ssh
   vrf {{ management.vrf }}

management api http-commands
   protocol https
   no protocol http
   vrf {{ management.vrf }}
      no shutdown

! ── Syslog ─────────────────────────────────────────────────
{% for server in management.syslog_servers %}
logging host {{ server }} vrf {{ management.vrf }}
{% endfor %}
logging trap informational

! ── SNMP ───────────────────────────────────────────────────
snmp-server vrf {{ management.vrf }}
snmp-server community {{ snmp_ro_community | default('CHANGEME') }} ro
snmp-server group SNMPV3_GROUP v3 priv
snmp-server user SNMPV3_USER SNMPV3_GROUP v3 auth sha {{ snmp_auth_key | default('CHANGEME_AUTH') }} priv aes {{ snmp_priv_key | default('CHANGEME_PRIV') }}

! ── Loopback ────────────────────────────────────────────────
interface Loopback0
   description "Router-ID / BGP Source"
   ip address {{ loopback.address }}

! ── Physical Interfaces ─────────────────────────────────────
{% for iface in interfaces %}
interface {{ iface.name }}
   description "{{ iface.description }}"
   no switchport
   ip address {{ iface.ip }}
   mtu 9214
   no shutdown
{% endfor %}

! ── BGP Underlay ────────────────────────────────────────────
router bgp {{ bgp.asn }}
   router-id {{ bgp.router_id }}
   no bgp default ipv4-unicast
   maximum-paths 4 ecmp 4
   !
   ! Underlay peer group
   neighbor UNDERLAY-LEAVES peer group
   neighbor UNDERLAY-LEAVES send-community
   neighbor UNDERLAY-LEAVES maximum-routes 12000
   !
{% for peer in bgp.underlay_peers %}
   neighbor {{ peer.peer_ip }} peer group UNDERLAY-LEAVES
   neighbor {{ peer.peer_ip }} remote-as {{ peer.peer_asn }}
   neighbor {{ peer.peer_ip }} description "{{ peer.description }}"
{% endfor %}
   !
   address-family ipv4
      neighbor UNDERLAY-LEAVES activate
{% for peer in bgp.underlay_peers %}
      neighbor {{ peer.peer_ip }} activate
{% endfor %}
      network {{ loopback.address }}

! ── BGP EVPN Overlay (Route Reflector) ──────────────────────
{% if bgp.evpn.enabled %}
   neighbor OVERLAY-EVPN peer group
   neighbor OVERLAY-EVPN update-source Loopback0
   neighbor OVERLAY-EVPN ebgp-multihop 3
   neighbor OVERLAY-EVPN send-community extended
   neighbor OVERLAY-EVPN maximum-routes 0
   !
{% for peer in bgp.evpn.overlay_peers %}
   neighbor {{ peer.peer_ip }} peer group OVERLAY-EVPN
   neighbor {{ peer.peer_ip }} remote-as {{ peer.peer_asn }}
   neighbor {{ peer.peer_ip }} description "{{ peer.description }}"
{% endfor %}
   !
   address-family evpn
      neighbor OVERLAY-EVPN activate
{% for peer in bgp.evpn.overlay_peers %}
      neighbor {{ peer.peer_ip }} activate
{% for peer in bgp.evpn.overlay_peers %}
{% endfor %}
{% endfor %}
{% endif %}

! ── NTP ─────────────────────────────────────────────────────
ntp server 10.0.0.100 vrf {{ management.vrf }}
ntp server 10.0.0.101 vrf {{ management.vrf }}

! ── AAA ─────────────────────────────────────────────────────
aaa authentication login default local
aaa authorization exec default local

! End of {{ hostname }} configuration
