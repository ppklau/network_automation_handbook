{# Cisco IOS — Branch WAN Router Template
   Input: nodes.yml entry with role: wan_router
   Generated by: playbooks/generate_configs.yml
   Do not edit this file directly on devices.
#}
! ============================================================
! {{ hostname }} — Cisco IOS Branch WAN Router
! Site: {{ site }}
! Generated by network automation pipeline
! Source of truth: inventory/nodes.yml
! Intents: {{ intent | join(', ') }}
! ============================================================

hostname {{ hostname }}

! ── Global ──────────────────────────────────────────────────
service password-encryption
ip routing
ip cef
no ip http server
no ip http secure-server
no cdp run

! ── VRF Definition ──────────────────────────────────────────
ip vrf {{ management.vrf }}
 rd 1:1

! ── Loopback ────────────────────────────────────────────────
interface Loopback0
 description "Router-ID / OSPF Source"
 ip address {{ loopback.address | ipaddr('address') }} {{ loopback.address | ipaddr('netmask') }}
 no shutdown

! ── ACLs (intent: INTENT-SEG-02) ────────────────────────────
{% for acl in acls %}
ip access-list extended {{ acl.name }}
{% for entry in acl.entries %}
 remark {{ entry.comment }}
 {{ entry.seq }} {{ entry.action }} {{ entry.protocol }}
 {%- if entry.src is defined %} {{ entry.src }}{% endif %}
 {%- if entry.dst is defined %} {{ entry.dst }}{% endif %}
 {%- if entry.dst_port is defined %}
 {%- if entry.dst_port == 'established' %} established
 {%- elif entry.dst_port is iterable and entry.dst_port is not string %}
 {%- for port in entry.dst_port %} eq {{ port }}{% endfor %}
 {%- elif entry.dst_port != 'any' %} eq {{ entry.dst_port }}
 {%- endif %}
 {%- endif %}

{% endfor %}
{% endfor %}

! ── Interfaces ──────────────────────────────────────────────
{% for iface in interfaces %}
interface {{ iface.name }}
 description "{{ iface.description }}"
{% if iface.ip == 'dhcp' %}
 ip address dhcp
{% else %}
 ip address {{ iface.ip | ipaddr('address') }} {{ iface.ip | ipaddr('netmask') }}
{% endif %}
{% if iface.zone == 'wan' %}
 ip access-group ACL_WAN_IN in
 ip nat outside
{% endif %}
{% if iface.zone == 'corporate' %}
 ip nat inside
{% endif %}
 no shutdown
!
{% endfor %}

! ── OSPF (intent: INTENT-RTG-03) ────────────────────────────
router ospf {{ ospf.process_id }}
 router-id {{ ospf.router_id }}
 area {{ ospf.area }} authentication message-digest
 default-information originate always
 passive-interface default
 no passive-interface GigabitEthernet0/2
!
{% for iface in interfaces %}
{% if iface.zone != 'wan' and iface.ip != 'dhcp' %}
 network {{ iface.ip | ipaddr('network') }} {{ iface.ip | ipaddr('hostmask') }} area {{ ospf.area }}
{% endif %}
{% endfor %}
 network {{ loopback.address | ipaddr('network') }} 0.0.0.0 area {{ ospf.area }}

! ── Management (intent: INTENT-MGMT-01) ─────────────────────
interface GigabitEthernet0/3
 description "OOB Management"
 ip vrf forwarding {{ management.vrf }}
 ip address {{ management.address | ipaddr('address') }} {{ management.address | ipaddr('netmask') }}
 no shutdown

ip route vrf {{ management.vrf }} 0.0.0.0 0.0.0.0 {{ management.address | ipaddr('network') | ipmath(1) }}

! ── SSH ─────────────────────────────────────────────────────
crypto key generate rsa modulus 4096
ip ssh version 2
ip ssh source-interface {{ management.ssh_source_interface }}
line vty 0 15
 login local
 transport input ssh
 ip access-class MGMT_ACCESS in

ip access-list standard MGMT_ACCESS
 permit {{ management.address | ipaddr('network') }} {{ management.address | ipaddr('hostmask') }}
 deny   any log

! ── Syslog (intent: INTENT-MGMT-02) ─────────────────────────
{% for server in management.syslog_servers %}
logging host {{ server }} vrf {{ management.vrf }}
{% endfor %}
logging trap informational
logging source-interface {{ management.ssh_source_interface }}

! ── SNMP (intent: INTENT-MGMT-02) ───────────────────────────
snmp-server group SNMPV3_GROUP v3 priv
snmp-server user SNMPV3_USER SNMPV3_GROUP v3 auth sha CHANGEME_AUTH priv aes 128 CHANGEME_PRIV
snmp-server ifindex persist

! ── NTP ─────────────────────────────────────────────────────
ntp source {{ management.ssh_source_interface }}
{% for server in management.syslog_servers %}
ntp server vrf {{ management.vrf }} {{ server }}
{% endfor %}

! ── AAA ─────────────────────────────────────────────────────
aaa new-model
aaa authentication login default local
aaa authorization exec default local

! End of {{ hostname }} configuration
